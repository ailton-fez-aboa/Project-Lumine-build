name: Build LumineBlock APK

on:
  workflow_dispatch:
  push:
    branches: [main]

permissions:
  contents: read

jobs:
  apk:
    runs-on: ubuntu-latest
    timeout-minutes: 40
    steps:
      - uses: actions/checkout@v4

      - name: Descompactar projeto
        run: unzip -q lumineblock-starry-sky-apk.zip

      - uses: actions/setup-node@v4
        with:
          node-version: "22"

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "21"

      - uses: oven-sh/setup-bun@v2
        with:
          bun-version: "1.4.4"

      - name: Instalar dependências
        working-directory: lumineblock
        run: bun install --frozen-lockfile

      - name: Compilar o site
        working-directory: lumineblock
        run: bun run build

      - name: Normalizar saída
        working-directory: lumineblock
        run: |
          if [ ! -d dist/client ] && [ -d .output/public ]; then
            mkdir -p dist
            cp -r .output/public dist/client
          fi
          ls -la dist/client
          cp dist/client/_shell.html dist/client/index.html

      - name: Criar projeto Android
        working-directory: lumineblock
        run: |
          bunx cap add android
          bunx cap sync android
          node scripts/android-offline.mjs

      - name: Gerar APK debug
        working-directory: lumineblock/android
        run: ./gradlew assembleDebug --no-daemon

      - name: Aplicar ícone do app
        working-directory: lumineblock
        run: cp -r icon-res/. android/app/src/main/res/

      - uses: actions/upload-artifact@v4
        with:
          name: LumineBlock-APK
          path: lumineblock/android/app/build/outputs/apk/debug/app-debug.apk
          if-no-files-found: error
          retention-days: 30
